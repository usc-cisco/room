# Local SQLite file. Relative paths resolve from the project root.
DATABASE_URL=./data/app.db

# Public origin of the app. Must match the Google redirect URI host.
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shown to a signed-in account that is not on the allowlist, as the address to
# ask about being added. Leave unset and the refusal page offers no address.
SUPPORT_EMAIL=

# Set to exactly "true" to show a notice above every screen warning that the
# timetable may be out of date or incomplete. Anything else leaves it off.
SHOW_DATA_NOTICE=

# Development only: freezes the app's clock so room schedules can be viewed at
# any date and time. Ignored in production builds. No timezone suffix means
# local time. Leave unset to use the real clock.
# NEXT_PUBLIC_DEV_NOW=2026-08-10T11:00
